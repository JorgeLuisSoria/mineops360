<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Requires_End_Date</fullName>
    <active>true</active>
    <description>Un contrato activo debe tener fecha de fin.</description>
    <errorConditionFormula
  >AND(ISPICKVAL(Status__c, &quot;Activo&quot;), ISBLANK(End_Date__c))</errorConditionFormula>
    <errorDisplayField>End_Date__c</errorDisplayField>
    <errorMessage>Un contrato activo necesita fecha de fin.</errorMessage>
</ValidationRule>
